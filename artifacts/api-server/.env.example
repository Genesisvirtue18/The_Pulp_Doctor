# MongoDB Atlas
MONGODB_URI=mongodb+srv://<db-user>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Replit-managed secret already available in this project; do not commit a value.
SESSION_SECRET=

# Email notifications via Resend's server-side REST API.
RESEND_API_KEY=
EMAIL_FROM=The Pulp Doctor <verified-sender@example.com>
DOCTOR_EMAIL=drcharu.25@gmail.com

# Private S3-compatible storage for clinical referral attachments.
S3_BUCKET_NAME=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional site configuration.
APP_ORIGIN=
PUBLIC_PHONE=
CANCELLATION_CUTOFF_HOURS=0
