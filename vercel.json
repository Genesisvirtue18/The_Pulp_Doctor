{
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/pulp-doctor run build",
  "outputDirectory": "artifacts/pulp-doctor/dist/public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://the-pulp-doctor.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
